# Every cookie variant AuthKit issues (internal/httpapi/cookies.go). Append-only:
# a changed name, path, domain or prefix is a new line; never edit or delete one.
refresh name=authkit_rt path=/ domain="" secure=false
refresh name=__Host-authkit_rt path=/ domain="" secure=true
oidc_state name=authkit_oauth_state_ path=/ domain="" secure=false
oidc_state name=__Host-authkit_oauth_state_ path=/ domain="" secure=true

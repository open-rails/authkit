{
  "error": {
    "type": "authorization_error",
    "code": "2fa_enrollment_required",
    "metadata": {
      "user_id": "$string",
      "requires_2fa_enrollment": true,
      "allowed_methods": "$array",
      "token_set": {
        "access_token": "$string",
        "token_type": "Bearer",
        "expires_in": "$number"
      }
    }
  }
}

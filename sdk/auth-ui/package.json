{
  "name": "@open-rails/auth-ui",
  "version": "0.0.0",
  "description": "Shared browser client, React hooks and UI for AuthKit.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-rails/auth-ui.git"
  },
  "homepage": "https://github.com/open-rails/auth-ui#readme",
  "bugs": {
    "url": "https://github.com/open-rails/auth-ui/issues"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{css,ts,tsx,json,md}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^4.1.11"
  }
}

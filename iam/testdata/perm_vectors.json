[
  {"grant": "org:members:read", "permission": "org:members:read", "matches": true},
  {"grant": "org:members:read", "permission": "org:members:write", "matches": false},
  {"grant": "org:members:read", "permission": "org:settings:read", "matches": false},
  {"grant": "org-2:api-keys:create", "permission": "org-2:api-keys:create", "matches": true},
  {"grant": "repo:update", "permission": "repo:update", "matches": true, "note": "two-segment literal (other platforms' tokens)"},
  {"grant": "org:members", "permission": "org:members:read", "matches": false},
  {"grant": "org:members:read:x", "permission": "org:members:read", "matches": false},

  {"grant": "org:*", "permission": "org:members:read", "matches": true, "note": "owner grant"},
  {"grant": "org:*", "permission": "org:members:read:x", "matches": true, "note": "owner grant covers any depth"},
  {"grant": "org:*", "permission": "org:update", "matches": true},
  {"grant": "org:*", "permission": "merchant:members:read", "matches": false, "note": "cross-persona"},
  {"grant": "org:*", "permission": "organization:members:read", "matches": false, "note": "persona is a segment, not a string prefix"},
  {"grant": "org:*", "permission": "root:users:ban", "matches": false},

  {"grant": "root:*", "permission": "root:users:ban", "matches": true},
  {"grant": "root:users:*", "permission": "root:users:ban", "matches": true},
  {"grant": "root:users:ban", "permission": "root:users:ban", "matches": true},
  {"grant": "root:*", "permission": "org:members:read", "matches": false, "note": "root is a persona like any other"},
  {"grant": "root:users:*", "permission": "org:users:ban", "matches": false},

  {"grant": "org:members:*", "permission": "org:members:read", "matches": true},
  {"grant": "org:members:*", "permission": "org:members:read:x", "matches": false, "note": "three-part rule: only <persona>:* spans depths"},
  {"grant": "org:members:*", "permission": "org:members", "matches": false},
  {"grant": "org:members:*", "permission": "org:settings:read", "matches": false},
  {"grant": "merchant:members:*", "permission": "org:members:read", "matches": false, "note": "cross-persona"},

  {"grant": "org:*:read", "permission": "org:members:read", "matches": true, "note": "mid-segment wildcard"},
  {"grant": "org:*:read", "permission": "org:members:write", "matches": false},
  {"grant": "org:*:*", "permission": "org:members:read", "matches": true},
  {"grant": "org:*:*", "permission": "org:members:read:x", "matches": false},
  {"grant": "org:*:*", "permission": "org:update", "matches": false},

  {"grant": "org:*", "permission": "org:*", "matches": true, "note": "pattern permission: grant covers all of it"},
  {"grant": "org:*", "permission": "org:members:*", "matches": true},
  {"grant": "org:*", "permission": "org:*:read", "matches": true},
  {"grant": "org:members:*", "permission": "org:members:*", "matches": true},
  {"grant": "org:*:*", "permission": "org:members:*", "matches": true},
  {"grant": "org:members:*", "permission": "org:*", "matches": false},
  {"grant": "org:*:*", "permission": "org:*", "matches": false},
  {"grant": "org:members:read", "permission": "org:members:*", "matches": false},
  {"grant": "org:*:read", "permission": "org:members:*", "matches": false},
  {"grant": "org:members:*", "permission": "org:*:read", "matches": false},

  {"grant": "*", "permission": "org:members:read", "matches": false, "note": "persona is always literal"},
  {"grant": "*", "permission": "*", "matches": false},
  {"grant": "*:*", "permission": "org:members:read", "matches": false},
  {"grant": "*:*:*", "permission": "org:members:read", "matches": false},
  {"grant": "*:members:read", "permission": "org:members:read", "matches": false},
  {"grant": "*:members:read", "permission": "*:members:read", "matches": false},

  {"grant": "", "permission": "org:members:read", "matches": false, "note": "malformed text matches nothing"},
  {"grant": "org:*", "permission": "", "matches": false},
  {"grant": "", "permission": "", "matches": false},
  {"grant": "org", "permission": "org", "matches": false},
  {"grant": "org:*", "permission": "org", "matches": false},
  {"grant": "org:*", "permission": "org:", "matches": false},
  {"grant": "org:members:*", "permission": "org:members:", "matches": false},
  {"grant": "org::read", "permission": "org::read", "matches": false},
  {"grant": ":*", "permission": ":members:read", "matches": false},
  {"grant": "org:*", "permission": "org:members:Read", "matches": false},
  {"grant": "Org:Members:Read", "permission": "Org:Members:Read", "matches": false},
  {"grant": "org:members_x:read", "permission": "org:members_x:read", "matches": false},
  {"grant": "1org:*", "permission": "1org:members:read", "matches": false},
  {"grant": "org:-members:read", "permission": "org:-members:read", "matches": false},
  {"grant": "org:members:rea*", "permission": "org:members:read", "matches": false},
  {"grant": "org:members:**", "permission": "org:members:read", "matches": false},
  {"grant": "org:mem bers:read", "permission": "org:mem bers:read", "matches": false},
  {"grant": " org:*", "permission": "org:members:read", "matches": false, "note": "nothing is trimmed"},
  {"grant": "org:members:read", "permission": " org:members:read ", "matches": false},
  {"grant": "org:members:read\n", "permission": "org:members:read\n", "matches": false},
  {"grant": "﻿org:*", "permission": "org:members:read", "matches": false},
  {"grant": "orġ:*", "permission": "orġ:members:read", "matches": false}
]
